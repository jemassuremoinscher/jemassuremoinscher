# Copier ce fichier en .env puis renseigner les valeurs.
# Ces variables sont TOUTES publiques (exposees au navigateur via Vite) :
# ne jamais placer ici la cle service_role, qui ne doit vivre que dans les
# secrets Supabase des fonctions Edge.

VITE_SUPABASE_PROJECT_ID="votre-project-ref"
VITE_SUPABASE_URL="https://votre-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="votre-cle-anon"

# Utilisees par les scripts Node de build (scripts/*.mjs)
SUPABASE_URL="https://votre-project-ref.supabase.co"
SUPABASE_PUBLISHABLE_KEY="votre-cle-anon"
