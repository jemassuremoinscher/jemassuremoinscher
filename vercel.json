{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/assurance-auto-malusse", "destination": "/assurance-auto-malus", "statusCode": 301 }
